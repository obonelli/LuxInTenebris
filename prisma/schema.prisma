generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CANDIDATE
  CLIENT
  SUPERADMIN
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  role          UserRole     @default(CANDIDATE)
  cvAnalyses    CvAnalysis[]
  cvHistories   CVHistory[] // historial de feedbacks
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CvAnalysis {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  targetRole String
  userNote   String?
  feedback   String   @db.LongText
  createdAt  DateTime @default(now())
}

/**
 * =======================
 * Jobs board (nuevo)
 * =======================
 */

enum Seniority {
  INTERN
  JUNIOR
  MID
  SENIOR
  STAFF
  LEAD
  PRINCIPAL
}

enum WorkingScheme {
  ONSITE
  HYBRID
  REMOTE
}

enum EnglishLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

model Technology {
  id        Int             @id @default(autoincrement())
  name      String          @unique
  slug      String          @unique
  jobs      JobTechnology[]
  createdAt DateTime        @default(now())
}

model JobPosition {
  id            String          @id @default(cuid())
  title         String
  description   String          @db.Text
  salaryMin     Int?
  salaryMax     Int?
  currency      String          @default("USD")
  seniority     Seniority
  workingScheme WorkingScheme
  englishLevel  EnglishLevel?
  location      String?
  provider      String?
  isActive      Boolean         @default(true)
  technologies  JobTechnology[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([title])
  @@index([seniority, workingScheme, englishLevel])
}

model JobTechnology {
  jobId        String
  technologyId Int
  job          JobPosition @relation(fields: [jobId], references: [id], onDelete: Cascade)
  technology   Technology  @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([jobId, technologyId])
}

/**
 * =======================
 * CV History (nuevo)
 * =======================
 */

model CVHistory {
  id                String   @id @default(cuid())
  userId            String
  summary           String?  @db.Text
  motivationalClose String?  @db.Text
  rawText           String   @db.LongText
  source            String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}
